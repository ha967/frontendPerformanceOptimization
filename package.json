{
  "name": "frontend-performance-optimization",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/generate-images.mjs --ensure",
    "images": "node scripts/generate-images.mjs",
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/generate-images.mjs --ensure",
    "prebenchmark": "npm run build",
    "benchmark": "node scripts/benchmark.mjs",
    "lint": "oxlint && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
